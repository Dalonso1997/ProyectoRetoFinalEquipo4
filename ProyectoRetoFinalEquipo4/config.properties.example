


# ==========================================
# CONFIGURACI\u00d3N DE LA BASE DE DATOS
# Cambia 'entorno' a 'local' o 'aws'
# ==========================================
entorno=local

# --- CONEXI\u00d3N AWS ---
aws.url=jdbc:mysql://IP_DEL_SERVIDOR:3306/inventario_taller
aws.user=TU_USUARIO
aws.pass=TU_CONTRASEÑA

# --- CONEXI\u00d3N LOCAL (Para pruebas en tu PC) ---
# (Asumiendo que usas XAMPP o similar con usuario root sin clave)
local.url=jdbc:mysql://localhost:3306/copia_inventario_taller
local.user=root
local.pass=TU_CONTRASEÑA
